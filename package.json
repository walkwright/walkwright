{
  "name": "walkwright",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "bump": "GITHUB_TOKEN=$(gh auth token) changeset version",
    "format-check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint --max-warnings=0 .",
    "release": "changeset publish && git push --follow-tags",
    "testwalk": "pnpm --dir packages/runtime run build && pnpm --dir packages/testbed run build && pnpm --dir packages/testbed run testwalk",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "prettier-plugin-pkg": "0.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
